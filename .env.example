# Copie este arquivo para ".env" e (se quiser) troque os valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).

# Login do InfluxDB (http://localhost:8086)
INFLUX_USER=bueiros
INFLUX_PASSWORD=bueiros-senha-123

# Token do InfluxDB (usado pelo Node-RED para gravar e pelo Grafana para ler)
INFLUX_TOKEN=token-bueiros-mackenzie-troque-isto

# Chave do OpenWeatherMap (https://home.openweathermap.org/api_keys)
# Pode ficar vazia: sem ela o fluxo usa uma previsao SIMULADA (20% de chuva).
OPENWEATHER_KEY=
